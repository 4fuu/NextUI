{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NextUI",
      "request": "launch",
      "type": "cppdbg",
      "osx": {
        "MIMode": "lldb",
        "environment": []
      },
      "linux": {
        "MIMode": "gdb",
        "environment": []
      },
      "cwd": "${workspaceFolder}/workspace/all/nextui/build/desktop",
      "program": "${workspaceFolder}/workspace/all/nextui/build/desktop/nextui.elf",
      "preLaunchTask": "make desktop",
      "envFile": "${workspaceFolder}/.env_desktop"
    },
